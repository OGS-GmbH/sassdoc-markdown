{
  "name": "@ogs-gmbh/sassdoc-markdown",
  "version": "1.0.2",
  "description": "Convert your SassDoc documentation to Markdown",
  "keywords": [
    "sassdoc",
    "markdown",
    "sassdoc-markdown",
    "convert",
    "sassdoc-plugin",
    "sassdoc-markdown-plugin",
    "sassdoc-convert",
    "sassdoc-converter"
  ],
  "homepage": "https://ogs-gmbh.github.io/sassdoc-markdown/",
  "bugs": "https://github.com/OGS-GmbH/sassdoc-markdown/issues",
  "license": "MIT",
  "author": "OGS GmbH",
  "bin": "./main.mjs",
  "contributors": [
    {
      "name": "Simon Kovtyk",
      "email": "simon@kovtyk.com",
      "url": "https://simonkov.dev"
    }
  ],
  "exports": {
    ".": {
      "types": "./public-api.d.ts",
      "default": "./public-api.mjs"
    }
  },
  "main": "./public-api.mjs",
  "types": "./public-api.d.ts",
  "repository": "github:OGS-GmbH/sassdoc-markdown",
  "type": "module",
  "scripts": {
    "ci:build:main:production": "node .esbuild/build.mjs",
    "ci:docs:extract:typedoc": "typedoc",
    "ci:docs:main:vitepress": "bash ./.vitepress/scripts/pre-vitepress.sh && vitepress build .vitepress",
    "ci:pr:commitlint:main:commitlint": "commitlint",
    "ci:pr:lint:main:eslint": "eslint .",
    "commit": "commit",
    "prepare": "husky",
    "vitepress": "bash ./.vitepress/scripts/pre-vitepress.sh && vitepress dev .vitepress",
    "vitepress:preview": "vitepress preview .vitepress"
  },
  "dependencies": {
    "@ogs-gmbh/markdown": "^1.1.5",
    "@ogs-gmbh/stdx": "^1.1.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@commitlint/prompt-cli": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@ogs-gmbh/linter": "^2.0.1",
    "@ogs-gmbh/vitepress-theme": "^1.1.0",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@types/node": "^25.2.0",
    "esbuild": "^0.27.2",
    "esbuild-plugin-d.ts": "^1.3.1",
    "esbuild-plugin-file-copy": "2.0.0-next.0",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "esbuild-plugin-package-json": "2.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^62.5.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-package-json-lint": "^9.1.0",
    "sass-embedded": "^1.97.3",
    "typedoc": "^0.28.16",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.1",
    "@ogs-gmbh/vitepress-plugin-sidebar": "^1"
  },
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist/main"
  }
}
